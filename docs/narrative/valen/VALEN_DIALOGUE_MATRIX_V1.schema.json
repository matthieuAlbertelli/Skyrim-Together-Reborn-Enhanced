{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stre.invalid/schemas/valen-dialogue-matrix-v1",
  "title": "Bounded Valen dialogue matrix v1 editorial contract",
  "$defs": {
    "condition": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "ClassId",
            "RosterSize",
            "QuestStage",
            "HadvarDiscovered",
            "RalofDiscovered"
          ]
        },
        "operator": {
          "enum": [
            "Equals",
            "Unknown",
            "LessThan",
            "GreaterThan",
            "GreaterOrEqual"
          ]
        },
        "value": {
          "type": [
            "string",
            "integer",
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "operator",
        "value"
      ],
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^VALEN_[A-Z0-9_]+$"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "segments": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "conditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/condition"
          }
        },
        "intent": {
          "type": "string",
          "minLength": 1
        },
        "emotion": {
          "type": "string",
          "minLength": 1
        },
        "intensity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "id",
        "text",
        "segments",
        "conditions",
        "intent",
        "emotion",
        "intensity"
      ],
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^VALEN_[A-Z0-9_]+$"
        },
        "category": {
          "enum": [
            "navigation",
            "self",
            "group",
            "recruit",
            "dragonborn",
            "dragons",
            "hq",
            "skyrim",
            "mission",
            "personal",
            "helgen",
            "helgen_pre",
            "helgen_active",
            "helgen_arrival"
          ]
        },
        "kind": {
          "enum": [
            "root",
            "menu",
            "dialogue",
            "exit"
          ]
        },
        "playerText": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "responses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/response"
          }
        },
        "conditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/condition"
          }
        },
        "parent": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^VALEN_[A-Z0-9_]+$"
        },
        "followups": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^VALEN_[A-Z0-9_]+$"
          },
          "uniqueItems": true
        },
        "returnTo": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^VALEN_[A-Z0-9_]+$"
        },
        "effect": {
          "enum": [
            "None",
            "AcceptHelgenStage10"
          ]
        },
        "scope": {
          "enum": [
            "LocalPresentation",
            "SharedQuest"
          ]
        },
        "repeatability": {
          "enum": [
            "Repeatable",
            "OnceBeforeStage10",
            "OncePerLocalSave"
          ]
        },
        "state": {
          "enum": [
            "approved",
            "reserved",
            "deferred"
          ]
        },
        "sourceHeading": {
          "type": "string",
          "minLength": 1
        },
        "leadIn": {
          "$ref": "#/$defs/response"
        },
        "route": {
          "enum": [
            "generic-survivor-topic",
            "explicit-survivor-declaration"
          ]
        }
      },
      "required": [
        "id",
        "category",
        "kind",
        "playerText",
        "responses",
        "conditions",
        "parent",
        "followups",
        "returnTo",
        "effect",
        "scope",
        "repeatability",
        "state"
      ],
      "additionalProperties": false
    },
    "survivorRule": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "hadvarDiscovered": {
          "type": "boolean"
        },
        "ralofDiscovered": {
          "type": "boolean"
        },
        "hadvarStates": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "ralofStates": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "selection": {
          "enum": [
            "automatic",
            "explicit"
          ]
        },
        "node": {
          "type": "string",
          "pattern": "^VALEN_[A-Z0-9_]+$"
        }
      },
      "required": [
        "id",
        "hadvarDiscovered",
        "ralofDiscovered",
        "hadvarStates",
        "ralofStates",
        "selection",
        "node"
      ],
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "const": "VALEN_DIALOGUE_MATRIX_V1"
    },
    "language": {
      "const": "fr-FR"
    },
    "source": {
      "type": "object",
      "properties": {
        "document": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[A-F0-9]{64}$"
        },
        "baseCommit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "legacyTextPolicy": {
          "type": "string",
          "minLength": 1
        },
        "editorialSha256": {
          "type": "string",
          "pattern": "^[A-F0-9]{64}$"
        },
        "amendments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "approvedOn": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "reviewer": {
                "type": "string",
                "minLength": 1
              },
              "nodeIds": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^VALEN_[A-Z0-9_]+$"
                }
              },
              "sha256": {
                "type": "string",
                "pattern": "^[A-F0-9]{64}$"
              }
            },
            "required": [
              "id",
              "approvedOn",
              "reviewer",
              "nodeIds",
              "sha256"
            ]
          }
        }
      },
      "required": [
        "document",
        "sha256",
        "baseCommit",
        "legacyTextPolicy",
        "editorialSha256",
        "amendments"
      ],
      "additionalProperties": false
    },
    "classes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^class\\.[a-z]+$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "projection": {
            "type": "integer",
            "minimum": 1,
            "maximum": 21
          }
        },
        "required": [
          "id",
          "label",
          "projection"
        ],
        "additionalProperties": false
      },
      "minItems": 21
    },
    "helgenMenuLabels": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "minimumStage": {
            "type": "integer",
            "minimum": 0
          },
          "maximumStage": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        },
        "required": [
          "text",
          "minimumStage",
          "maximumStage"
        ],
        "additionalProperties": false
      },
      "minItems": 3
    },
    "objective20": {
      "const": "Enquêter sur les ruines de Helgen."
    },
    "authoringDecisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "approved",
              "pending"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "status",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      },
      "minItems": 1
    },
    "survivors": {
      "type": "object",
      "properties": {
        "states": {
          "type": "object",
          "properties": {
            "Uninitialized": {
              "const": 0
            },
            "WoundedInCave": {
              "const": 1
            },
            "CapturedInKeep": {
              "const": 2
            },
            "Freed": {
              "const": 3
            },
            "Departed": {
              "const": 4
            }
          },
          "required": [
            "Uninitialized",
            "WoundedInCave",
            "CapturedInKeep",
            "Freed",
            "Departed"
          ],
          "additionalProperties": false
        },
        "discoveryStages": {
          "type": "object",
          "properties": {
            "HadvarDiscovered": {
              "const": 11
            },
            "RalofDiscovered": {
              "const": 12
            }
          },
          "required": [
            "HadvarDiscovered",
            "RalofDiscovered"
          ],
          "additionalProperties": false
        },
        "genericPlayerText": {
          "const": "Nous devons parler de ce que nous avons trouvé à Helgen."
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/survivorRule"
          },
          "minItems": 1
        },
        "firstReports": {
          "type": "object",
          "properties": {
            "00": {
              "type": "string",
              "pattern": "^VALEN_[A-Z0-9_]+$"
            },
            "01": {
              "type": "string",
              "pattern": "^VALEN_[A-Z0-9_]+$"
            },
            "10": {
              "type": "string",
              "pattern": "^VALEN_[A-Z0-9_]+$"
            },
            "11": {
              "type": "string",
              "pattern": "^VALEN_[A-Z0-9_]+$"
            }
          },
          "required": [
            "00",
            "01",
            "10",
            "11"
          ],
          "additionalProperties": false
        },
        "bothRescuedPairs": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            "minItems": 2
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "states",
        "discoveryStages",
        "genericPlayerText",
        "rules",
        "firstReports",
        "bothRescuedPairs"
      ],
      "additionalProperties": false
    },
    "audio": {
      "type": "object",
      "properties": {
        "sampleRate": {
          "const": 44100
        },
        "channels": {
          "const": 1
        },
        "sampleWidth": {
          "const": 2
        },
        "charactersPerSecond": {
          "const": 15
        },
        "minimumSeconds": {
          "const": 2
        },
        "paddingSeconds": {
          "const": 0.75
        },
        "format": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "sampleRate",
        "channels",
        "sampleWidth",
        "charactersPerSecond",
        "minimumSeconds",
        "paddingSeconds",
        "format"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "language",
    "source",
    "classes",
    "helgenMenuLabels",
    "objective20",
    "authoringDecisions",
    "nodes",
    "survivors",
    "audio"
  ],
  "additionalProperties": false
}
